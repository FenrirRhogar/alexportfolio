<%# Optional on the "new" form: a first flipbook and/or trifold, created in the
    same save. More can be added — and pages reordered — on the edit page. %>
<details class="media-card site-section new-book-fields">
  <summary><h3>📖 Add a flipbook (optional)</h3></summary>
  <p class="hint">Page images shown as a flip-through book — a booklet, catalogue, or comic. Select the pages in reading order; you can reorder them afterwards.</p>
  <label class="field">
    <span>Flipbook title</span>
    <input type="text" name="newBookletTitle" placeholder="e.g. Chapter one" />
  </label>
  <label class="field">
    <span>Page images, in order</span>
    <input type="file" name="newBookletPages" accept="image/jpeg,image/png,image/webp,image/gif,image/avif" multiple />
  </label>
  <label class="field">
    <span>Source PDF (optional, offered as a download)</span>
    <input type="file" name="newBookletPdf" accept="application/pdf" />
  </label>
</details>

<details class="media-card site-section new-book-fields">
  <summary><h3>🪧 Add a trifold (optional)</h3></summary>
  <p class="hint">One sheet printed on both sides and folded into three — just the outside and inside images.</p>
  <label class="field">
    <span>Trifold title</span>
    <input type="text" name="newTrifoldTitle" placeholder="e.g. Event leaflet" />
  </label>
  <div class="trifold-grid">
    <label class="field">
      <span>Outside</span>
      <input type="file" name="outside" accept="image/jpeg,image/png,image/webp,image/gif,image/avif" />
    </label>
    <label class="field">
      <span>Inside</span>
      <input type="file" name="inside" accept="image/jpeg,image/png,image/webp,image/gif,image/avif" />
    </label>
  </div>
</details>
