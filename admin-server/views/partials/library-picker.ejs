<%# "…or choose from the media library": a grid of existing files as radio
    buttons (one slot) or checkboxes (gallery). Images load only once opened. %>
<% const already = [].concat(current || []); %>
<% const choices = files.filter((m) => !already.includes(m.path)); %>
<% if (choices.length) { %>
  <details class="library-picker">
    <summary><%= multiple ? '…or add images from the media library' : '…or choose one from the media library' %>
      <span class="muted">(<%= choices.length %>)</span></summary>
    <div class="picker-grid">
      <% if (!multiple) { %>
        <label class="picker-item picker-none">
          <input type="radio" name="<%= name %>" value="" checked />
          <span>Keep as is</span>
        </label>
      <% } %>
      <% choices.forEach((m) => { %>
        <label class="picker-item" title="<%= m.path %>">
          <input type="<%= multiple ? 'checkbox' : 'radio' %>" name="<%= name %>" value="<%= m.path %>" />
          <% if (m.kind === 'video') { %>
            <video src="<%= m.path %>" muted preload="none"></video>
          <% } else { %>
            <img src="<%= m.path %>" alt="" loading="lazy" />
          <% } %>
          <span class="picker-name"><%= m.name %><% if (!m.usedBy.length) { %> · <em>unused</em><% } %></span>
        </label>
      <% }) %>
    </div>
  </details>
<% } %>
