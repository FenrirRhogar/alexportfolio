<% if (schema.hasFlipbooks && entry) { %>
    <section class="flipbooks-section" id="flipbooks">
      <div class="section-heading">
        <h2>📖 Flipbooks</h2>
        <p class="hint">A set of page images shown as a flip-through book on the project page. Drag pages to reorder them (on a phone or tablet, press and hold a page first), or use ‹ › to move a page one place. The new order saves by itself.</p>
      </div>

      <% (entry.data.booklets || []).forEach((b, i) => { %>
        <div class="media-card">
          <div class="media-card-head">
            <form method="post" action="/admin/<%= schema.key %>/<%= entry.slug %>/booklets/<%= i %>/rename" enctype="multipart/form-data" class="inline-form">
              <input type="text" name="title" value="<%= b.title %>" class="title-input" />
              <select name="size" class="size-select" title="How big this flipbook is on the page">
                <% sizeOptions.forEach((o) => { %>
                  <option value="<%= o.value %>" <%= (b.size || '') === o.value ? 'selected' : '' %>>Size: <%= o.label %></option>
                <% }) %>
              </select>
              <label class="file-chip">
                <input type="file" name="bookletPdf" accept="application/pdf" />
                📎 Replace PDF
              </label>
              <button type="submit" class="button small">Save</button>
            </form>
            <% if (b.pdf) { %><a class="pdf-link" href="<%= b.pdf %>" target="_blank" rel="noopener">current PDF ↗</a><% } %>
            <form method="post" action="/admin/<%= schema.key %>/<%= entry.slug %>/booklets/<%= i %>/delete"
                  data-confirm="Delete this whole flipbook? This cannot be undone." class="inline-form">
              <button type="submit" class="link-button danger">Delete flipbook</button>
            </form>
          </div>

          <p class="reorder-status muted" aria-live="polite"></p>
          <ul class="page-grid reorder-pages" data-endpoint="/admin/<%= schema.key %>/<%= entry.slug %>/booklets/<%= i %>/reorder-pages">
            <% b.pages.forEach((p) => { %>
              <li class="page-thumb" data-src="<%= p %>">
                <img src="<%= p %>" alt="" loading="lazy" draggable="false" />
                <span class="page-num"></span>
                <span class="page-move">
                  <button type="button" class="page-step" data-step="-1" title="Move one place earlier" aria-label="Move earlier">‹</button>
                  <button type="button" class="page-step" data-step="1" title="Move one place later" aria-label="Move later">›</button>
                </span>
                <form method="post" action="/admin/<%= schema.key %>/<%= entry.slug %>/booklets/<%= i %>/delete-page"
                      data-confirm="Remove this page?">
                  <input type="hidden" name="page" value="<%= p %>" />
                  <button type="submit" class="page-delete" title="Remove this page">×</button>
                </form>
              </li>
            <% }) %>
          </ul>

          <form method="post" action="/admin/<%= schema.key %>/<%= entry.slug %>/booklets/<%= i %>/pages" enctype="multipart/form-data" class="inline-form add-pages-form">
            <input type="file" name="morePages" accept="image/jpeg,image/png,image/webp,image/gif,image/avif" multiple />
            <button type="submit" class="button small">+ Add pages</button>
            <%- include('library-picker', { files: library.image, name: 'pagePick', multiple: true, ordered: true, current: [], label: '…or add pages from the media library' }) %>
          </form>
        </div>
      <% }) %>

      <div class="media-card new-card">
        <h3>+ New flipbook</h3>
        <form method="post" action="/admin/<%= schema.key %>/<%= entry.slug %>/booklets" enctype="multipart/form-data" class="stacked-form">
          <label class="field">
            <span>Title</span>
            <input type="text" name="title" placeholder="e.g. Product catalogue" required />
          </label>
          <label class="field">
            <span>Page images, in order</span>
            <input type="file" name="newBookletPages" accept="image/jpeg,image/png,image/webp,image/gif,image/avif" multiple />
          </label>
          <%- include('library-picker', { files: library.image, name: 'pagePick', multiple: true, ordered: true, current: [], label: '…or choose pages from the media library' }) %>
          <label class="field">
            <span>Source PDF (optional, just a download link alongside the pages)</span>
            <input type="file" name="newBookletPdf" accept="application/pdf" />
          </label>
          <div class="form-actions">
            <button type="submit" class="button">Create flipbook</button>
          </div>
        </form>
      </div>
    </section>

    <section class="flipbooks-section" id="trifolds">
      <div class="section-heading">
        <h2>🪧 Trifolds</h2>
        <p class="hint">One sheet, printed both sides and folded into three — just the outside and inside images.</p>
      </div>

      <% (entry.data.trifolds || []).forEach((t, i) => { %>
        <div class="media-card">
          <form method="post" action="/admin/<%= schema.key %>/<%= entry.slug %>/trifolds/<%= i %>" enctype="multipart/form-data" class="stacked-form">
            <label class="field">
              <span>Title</span>
              <input type="text" name="title" value="<%= t.title %>" />
            </label>
            <label class="field">
              <span>Size on the page</span>
              <select name="size">
                <% sizeOptions.forEach((o) => { %>
                  <option value="<%= o.value %>" <%= (t.size || '') === o.value ? 'selected' : '' %>><%= o.label %></option>
                <% }) %>
              </select>
            </label>
            <div class="trifold-grid">
              <label class="field">
                <span>Outside</span>
                <img class="current-media" src="<%= t.outside %>" alt="" />
                <input type="file" name="outside" accept="image/jpeg,image/png,image/webp,image/gif,image/avif" />
              </label>
              <label class="field">
                <span>Inside</span>
                <img class="current-media" src="<%= t.inside %>" alt="" />
                <input type="file" name="inside" accept="image/jpeg,image/png,image/webp,image/gif,image/avif" />
              </label>
            </div>
            <div class="form-actions">
              <button type="submit" class="button small">Save</button>
            </div>
          </form>
          <form method="post" action="/admin/<%= schema.key %>/<%= entry.slug %>/trifolds/<%= i %>/delete"
                data-confirm="Delete this trifold? This cannot be undone.">
            <button type="submit" class="link-button danger">Delete trifold</button>
          </form>
        </div>
      <% }) %>

      <div class="media-card new-card">
        <h3>+ New trifold</h3>
        <form method="post" action="/admin/<%= schema.key %>/<%= entry.slug %>/trifolds" enctype="multipart/form-data" class="stacked-form">
          <label class="field">
            <span>Title</span>
            <input type="text" name="title" placeholder="e.g. Dental clinic trifold" />
          </label>
          <div class="trifold-grid">
            <label class="field">
              <span>Outside</span>
              <input type="file" name="outside" accept="image/jpeg,image/png,image/webp,image/gif,image/avif" required />
            </label>
            <label class="field">
              <span>Inside</span>
              <input type="file" name="inside" accept="image/jpeg,image/png,image/webp,image/gif,image/avif" required />
            </label>
          </div>
          <div class="form-actions">
            <button type="submit" class="button">Create trifold</button>
          </div>
        </form>
      </div>
    </section>

    <script src="/admin/vendor/Sortable.min.js"></script>
    <script src="/admin/flipbook-reorder.js"></script>
<% } %>
