<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %> — Portfolio Admin</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter:wght@400;500;600;700&display=swap" />
  <link rel="stylesheet" href="/admin/style.css" />
  <script src="/admin/confirm.js" defer></script>
  <script src="/admin/upload.js" defer></script>
  <script src="/admin/picker.js" defer></script>
</head>
<body>
  <% if (typeof hideNav === 'undefined' || !hideNav) { %>
  <header class="topbar">
    <a href="/admin" class="brand">✎ Portfolio Admin</a>
    <nav>
      <a href="/admin/design">🎨 Design</a>
      <a href="/admin/motion">🎬 Motion</a>
      <a href="/admin/fineart">🖼️ Fine Art</a>
      <a href="/admin/site">⚙️ Site content</a>
      <a href="/admin/media">🗂️ Media</a>
    </nav>
    <a href="/" class="view-site-link" target="_blank" rel="noopener">View site ↗</a>
    <form method="post" action="/admin/rebuild" class="logout-form" title="<%= build.state === 'failed' ? 'Last rebuild failed: ' + build.error : 'Rebuild the public site now' %>">
      <button type="submit"><%= build.state === 'building' ? 'Publishing…' : build.state === 'failed' ? '⚠ Publish failed — retry' : 'Republish' %></button>
    </form>
    <form method="post" action="/admin/logout" class="logout-form">
      <button type="submit"<% if (accessEmail) { %> title="Signed in as <%= accessEmail %>"<% } %>>Log out<% if (accessEmail) { %> <span class="signed-in-as"><%= accessEmail %></span><% } %></button>
    </form>
  </header>
  <% } %>
  <main class="container">
    <% if (typeof flash !== 'undefined' && flash) { %>
      <div class="flash <%= flash.type %>"><%= flash.message %></div>
    <% } %>
