<%- include('partials/header', { title: 'Dashboard', flash }) %>

<h1>What would you like to edit?</h1>

<% if (build.state === 'failed') { %>
  <div class="flash error">
    The last publish failed, so the site is still showing the previous version. Fix the problem below, then press "Publish failed — retry" at the top.
    <pre class="build-error"><%= build.error %></pre>
  </div>
<% } %>

<% if (homepage.featuredTotal > homepage.limit) { %>
  <div class="flash info">
    <%= homepage.featuredTotal %> projects are featured, but the homepage shows <%= homepage.limit %> — it takes one from each section in turn.
    To show more, raise the number in <a href="/admin/site">Site content → Homepage — work</a>.
  </div>
<% } %>

<div class="card-grid">
  <% collections.forEach((c) => { %>
    <a class="card card-<%= c.key %>" href="/admin/<%= c.key %>">
      <h2><%= c.label %></h2>
      <p><%= c.count %> <%= c.count === 1 ? c.singular.toLowerCase() : c.singular.toLowerCase() + 's' %> · <%= c.onHomepage %> on the homepage<% if (c.featured > c.onHomepage) { %> (<%= c.featured - c.onHomepage %> more featured)<% } %></p>
    </a>
  <% }) %>
  <a class="card" href="/admin/site">
    <h2>⚙️ Site content</h2>
    <p>Colors, animations, menu, and every page's text — homepage, section pages, About, Contact, footer</p>
  </a>
  <a class="card" href="/admin/media">
    <h2>🗂️ Media library</h2>
    <p><%= media.count %> files · <%= (media.size / 1024 / 1024).toFixed(0) %> MB<% if (media.unused) { %> · <%= media.unused %> unused<% } %></p>
  </a>
  <a class="card" href="/admin/backup">
    <h2>💾 Download a backup</h2>
    <p>Every project, text, image, and video in one file — keep a copy somewhere safe</p>
  </a>
</div>

<p class="muted publish-status">
  <% if (build.state === 'ok') { %>Site last published <%= build.finishedAt.toLocaleString('en-GB', { dateStyle: 'medium', timeStyle: 'short' }) %>.<% } %>
  <% if (build.state === 'building') { %>Publishing your latest changes…<% } %>
</p>

<%- include('partials/footer') %>
