<%- include('partials/header', { title: 'Site content', flash }) %>

<div class="list-header">
  <h1>Site content</h1>
  <div class="list-header-actions">
    <a href="/admin/raw/site/global" class="button ghost small">Edit raw file</a>
    <a href="/" target="_blank" rel="noopener" class="button ghost small">View site ↗</a>
  </div>
</div>
<p class="hint">Everything around your projects: colors, animations, the menu, every page's text, links, and images. Click a section to open it — one Save button covers them all.</p>

<form method="post" enctype="multipart/form-data" class="entry-form">
  <% sections.forEach((section, i) => { %>
    <details class="media-card site-section" <%= i === 0 ? 'open' : '' %>>
      <summary><h3><%= section.heading %></h3></summary>
      <% section.fields.forEach((f) => { %>
        <% const value = site[f.name] ?? f.default; %>
        <%- include('partials/field', { f, value }) %>
      <% }) %>

      <% if (section.heading === 'About page') { %>
        <label class="field">
          <span>Photo</span>
          <% if (site.aboutPhoto) { %>
            <div class="current-media">
              <img src="<%= site.aboutPhoto %>" alt="" />
              <span class="muted">current photo — choose a new one below to replace it, or remove it entirely</span>
            </div>
            <span><input type="checkbox" name="removeAboutPhoto" value="1" /> Remove this photo (hide it on the About page)</span>
          <% } %>
          <input type="file" name="aboutPhoto" accept="image/jpeg,image/png,image/webp,image/gif,image/avif" />
        </label>
      <% } %>
    </details>
  <% }) %>

  <div class="form-actions sticky-actions">
    <button type="submit">Save</button>
  </div>
</form>

<script src="/admin/site.js"></script>

<%- include('partials/footer') %>
