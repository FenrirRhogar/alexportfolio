<%- include('partials/header', { title: 'Site content', flash }) %>

<div class="list-header">
  <h1>Site content</h1>
  <a href="/" target="_blank" rel="noopener" class="button ghost small">View site ↗</a>
</div>
<p class="hint">Everything here is the text, links, and images shown around the site — the homepage, About, Contact, and footer — outside of your Design/Motion/Fine Art projects themselves.</p>

<form method="post" enctype="multipart/form-data" class="entry-form">
  <% sections.forEach((section) => { %>
    <div class="media-card">
      <h3><%= section.heading %></h3>
      <% section.fields.forEach((f) => { %>
        <% const value = site[f.name]; %>
        <%- include('partials/field', { f, value }) %>
      <% }) %>

      <% if (section.heading === 'About page') { %>
        <label class="field">
          <span>Photo</span>
          <% if (site.aboutPhoto) { %>
            <div class="current-media">
              <img src="<%= site.aboutPhoto %>" alt="" />
              <span class="muted">current photo — choose a new one below to replace it, or remove it entirely</span>
            </div>
            <span><input type="checkbox" name="removeAboutPhoto" value="1" /> Remove this photo (hide it on the About page)</span>
          <% } %>
          <input type="file" name="aboutPhoto" accept="image/jpeg,image/png,image/webp,image/gif,image/avif" />
        </label>
      <% } %>
    </div>
  <% }) %>

  <div class="form-actions">
    <button type="submit">Save</button>
  </div>
</form>

<%- include('partials/footer') %>
