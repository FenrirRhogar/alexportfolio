# Copy this to .env and fill in real values. Never commit the real .env.

PORT=3000

# Absolute path to the site folder (this repo) on the host — mounted into the
# container at /site. The dashboard edits content files there and rebuilds
# the public site into its dist/ folder.
SITE_REPO_HOST_PATH=/path/to/alexportfolio

# Public URL and base path the site is built for.
SITE_URL=https://alex.example.com
SITE_BASE=/

# Generate with: node -e "import('bcryptjs').then(b=>b.hash(process.argv[1],10)).then(console.log)" "your-password-here"
ADMIN_PASSWORD_HASH=

# Any long random string — generate with: openssl rand -hex 32
SESSION_SECRET=

# Set to "true" once this is served over HTTPS (behind your reverse
# proxy) — until then, leave it false or the login cookie won't be sent.
COOKIE_SECURE=false

# Optional: require Cloudflare Access in front of /admin (see README.md).
# Team domain from Zero Trust, and the application's AUD tag.
# CF_ACCESS_TEAM_DOMAIN=yourteam.cloudflareaccess.com
# CF_ACCESS_AUD=

ASTRO_TELEMETRY_DISABLED=1
