# Copy this to .env and fill in real values. Never commit the real .env.

PORT=3000

# Absolute path to the portfolio site's git checkout *on the machine this
# server runs on* — the admin app reads/writes content files here directly
# and commits + pushes from it. See README.md for how to set this up.
SITE_REPO_PATH=/path/to/Portfolio-Alex

# Generate with: node -e "import('bcryptjs').then(b=>b.hash(process.argv[1],10)).then(console.log)" "your-password-here"
ADMIN_PASSWORD_HASH=

# Any long random string — generate with: openssl rand -hex 32
SESSION_SECRET=

# Set to "true" once this is served over HTTPS (behind your reverse
# proxy) — until then, leave it false or the login cookie won't be sent.
COOKIE_SECURE=false
