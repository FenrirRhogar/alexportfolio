# Copy this to .env and fill in real values. Never commit the real .env.

PORT=3000

# Absolute path to the portfolio site's git checkout *on the machine this
# server runs on* — the admin app reads/writes content files here directly
# and commits + pushes from it. See README.md for how to set this up.
SITE_REPO_PATH=/path/to/Portfolio-Alex

# Where the public portfolio pages themselves are served from. Everything
# that isn't under /admin is proxied straight through to this origin, so
# Alexandra (and visitors) use one URL — the site at "/", her edit panel
# at "/admin" — rather than two separate addresses. Point this at:
#   - your live GitHub Pages URL (include the project path — e.g.
#     https://fenrirrhogar.github.io/alexportfolio), to keep that as the
#     public CDN and just use this server as a unified front door for
#     editing, or
#   - a local static file server (e.g. `npx serve dist`) if you'd rather
#     self-host the public site from here too.
PUBLIC_SITE_ORIGIN=https://fenrirrhogar.github.io/alexportfolio

# Generate with: node -e "import('bcryptjs').then(b=>b.hash(process.argv[1],10)).then(console.log)" "your-password-here"
ADMIN_PASSWORD_HASH=

# Any long random string — generate with: openssl rand -hex 32
SESSION_SECRET=

# Set to "true" once this is served over HTTPS (behind your reverse
# proxy) — until then, leave it false or the login cookie won't be sent.
COOKIE_SECURE=false
