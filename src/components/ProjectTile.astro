---
interface Props {
  href: string;
  image: string;
  title: string;
  meta: string;
  discipline?: string;
  class?: string;
}

const { href, image, title, meta, discipline, class: className = '' } = Astro.props;
---

<a
  href={href}
  data-cursor-hover
  class:list={['group block break-inside-avoid mb-8 md:mb-12', className]}
>
  <div class="overflow-hidden bg-paper-dim">
    <img
      src={image}
      alt={title}
      loading="lazy"
      class="w-full h-auto object-cover transition-transform duration-700 ease-out group-hover:scale-[1.04]"
    />
  </div>
  <div class="flex items-baseline justify-between mt-4 gap-4">
    <h3 class="font-display italic text-2xl md:text-3xl leading-tight">{title}</h3>
    {discipline && (
      <span class="shrink-0 text-[11px] uppercase tracking-widest text-ink-soft">{discipline}</span>
    )}
  </div>
  <p class="text-sm text-ink-soft mt-1">{meta}</p>
</a>
