---
import { withBase } from '../lib/url';

const links = [
  { href: '/', label: 'Work' },
  { href: '/design/', label: 'Design & Branding' },
  { href: '/motion/', label: 'Motion & Video' },
  { href: '/fine-art/', label: 'Fine Art' },
  { href: '/about/', label: 'About' },
  { href: '/contact/', label: 'Contact' },
];
const path = Astro.url.pathname;
---

<header class="fixed top-0 left-0 right-0 z-50">
  <div class="absolute inset-x-0 top-0 h-28 bg-gradient-to-b from-paper via-paper/60 to-transparent pointer-events-none -z-10"></div>
  <nav class="flex items-center justify-between px-6 md:px-10 py-5 text-ink">
    <a href={withBase('/')} class="font-display italic text-2xl tracking-tight" data-cursor-hover>
      Alex&nbsp;Rivera
    </a>

    <button
      id="nav-toggle"
      class="md:hidden font-sans text-sm uppercase tracking-widest"
      aria-expanded="false"
      aria-controls="nav-menu"
    >
      Menu
    </button>

    <ul class="hidden md:flex items-center gap-8 font-sans text-sm uppercase tracking-widest">
      {links.map((l) => (
        <li>
          <a
            href={withBase(l.href)}
            data-cursor-hover
            class:list={[
              'link-hover pb-1',
              path === withBase(l.href) || (l.href !== '/' && path.startsWith(withBase(l.href)))
                ? 'opacity-100'
                : 'opacity-70 hover:opacity-100',
            ]}
          >
            {l.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <ul
    id="nav-menu"
    class="md:hidden hidden flex-col gap-2 px-6 pt-4 pb-10 font-display italic text-4xl bg-ink text-paper fixed inset-x-0 top-[72px] bottom-0 justify-center"
  >
    {links.map((l) => (
      <li>
        <a href={withBase(l.href)} class="block py-2">{l.label}</a>
      </li>
    ))}
  </ul>
</header>

<script>
  const toggle = document.getElementById('nav-toggle');
  const menu = document.getElementById('nav-menu');
  toggle?.addEventListener('click', () => {
    const isOpen = menu?.classList.toggle('flex');
    menu?.classList.toggle('hidden');
    toggle.setAttribute('aria-expanded', String(!!isOpen));
    toggle.textContent = isOpen ? 'Close' : 'Menu';
  });
</script>
