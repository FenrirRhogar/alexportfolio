---
const year = new Date().getFullYear();
---

<footer class="border-t border-ink/10 px-6 md:px-10 py-10 mt-24">
  <div class="flex flex-col md:flex-row md:items-end justify-between gap-6">
    <div>
      <p class="font-display italic text-3xl">Let's make something.</p>
      <a
        href="mailto:hello@yourname.com"
        data-cursor-hover
        class="link-hover text-sm uppercase tracking-widest text-ink-soft"
      >
        hello@yourname.com
      </a>
    </div>
    <div class="flex items-center gap-6 text-sm uppercase tracking-widest text-ink-soft">
      <a href="https://instagram.com/" data-cursor-hover class="link-hover" target="_blank" rel="noopener">Instagram</a>
      <a href="https://vimeo.com/" data-cursor-hover class="link-hover" target="_blank" rel="noopener">Vimeo</a>
      <a href="https://linkedin.com/" data-cursor-hover class="link-hover" target="_blank" rel="noopener">LinkedIn</a>
    </div>
  </div>
  <p class="mt-10 text-xs text-ink-soft/70">&copy; {year} Alexandra Patsi. All rights reserved.</p>
</footer>
