---
import { getEntry } from 'astro:content';

const year = new Date().getFullYear();
const site = (await getEntry('site', 'global')).data;
---

<footer class="border-t border-ink/10 px-6 md:px-10 py-10 mt-24">
  <div class="flex flex-col md:flex-row md:items-end justify-between gap-6">
    <div>
      <p class="font-display italic text-3xl">{site.footerTagline}</p>
      <a
        href={`mailto:${site.email}`}
        data-cursor-hover
        class="link-hover text-sm uppercase tracking-widest text-ink-soft"
      >
        {site.email}
      </a>
    </div>
    <div class="flex items-center gap-6 text-sm uppercase tracking-widest text-ink-soft">
      {site.instagram && <a href={site.instagram} data-cursor-hover class="link-hover" target="_blank" rel="noopener">Instagram</a>}
      {site.linkedin && <a href={site.linkedin} data-cursor-hover class="link-hover" target="_blank" rel="noopener">LinkedIn</a>}
    </div>
  </div>
  <p class="mt-10 text-xs text-ink-soft/70">&copy; {year} {site.brandName}. All rights reserved.</p>
</footer>
