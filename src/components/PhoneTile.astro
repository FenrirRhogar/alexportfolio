---
import { withBase } from '../lib/url';

interface Props {
  href: string;
  poster: string;
  video: string;
  videoWebm?: string;
  title: string;
  meta: string;
  vertical?: boolean;
  /** play muted on a loop while on screen, instead of only on hover */
  autoplay?: boolean;
  revealDelay?: number;
  class?: string;
}

const {
  href,
  poster,
  video,
  videoWebm,
  title,
  meta,
  vertical = true,
  autoplay = false,
  revealDelay = 0,
  class: className = '',
} = Astro.props;
---

<a
  href={withBase(href)}
  data-cursor-hover
  data-phone-tile
  class:list={['reveal group block', vertical ? '' : 'col-span-2', className]}
  style={`--reveal-delay: ${revealDelay}ms`}
>
  <div
    class:list={[
      'relative overflow-hidden rounded-[1.25rem] bg-charcoal ring-1 ring-ink/10',
      vertical ? 'aspect-9/16' : 'aspect-video',
    ]}
  >
    <video
      class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.04]"
      poster={withBase(poster)}
      muted
      loop
      playsinline
      preload="none"
      data-autoplay={autoplay ? '' : undefined}
    >
      {videoWebm && <source src={withBase(videoWebm)} type="video/webm" />}
      <source src={withBase(video)} type="video/mp4" />
    </video>

    <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-charcoal/80 via-transparent to-transparent"></div>

    <div
      class:list={[
        'pointer-events-none absolute right-4 top-4 flex h-9 w-9 items-center justify-center rounded-full border border-paper/50 text-paper opacity-90 transition-opacity group-hover:opacity-0',
        autoplay && 'hidden',
      ]}
      aria-hidden="true"
    >
      <svg width="12" height="12" viewBox="0 0 12 12" fill="currentColor"><path d="M1 0.5v11l10-5.5z"/></svg>
    </div>

    <div class="absolute inset-x-0 bottom-0 h-1 bg-(--color-motion) origin-left scale-x-0 transition-transform duration-500 group-hover:scale-x-100"></div>

    <div class="absolute inset-x-0 bottom-0 p-4 text-paper">
      <h3 class="font-display italic text-xl leading-tight">{title}</h3>
      <p class="text-xs uppercase tracking-widest text-paper/70 mt-1">{meta}</p>
    </div>
  </div>
</a>

<script>
  function attachPhoneTiles() {
    document.querySelectorAll('[data-phone-tile]').forEach((tile) => {
      const video = tile.querySelector('video');
      // autoplaying tiles are driven by the shared on-screen player in Layout.astro
      if (!video || video.dataset.bound || 'autoplay' in video.dataset) return;
      video.dataset.bound = 'true';
      tile.addEventListener('mouseenter', () => {
        video.play().catch(() => {});
      });
      tile.addEventListener('mouseleave', () => {
        video.pause();
        video.currentTime = 0;
      });
    });
  }
  attachPhoneTiles();
  document.addEventListener('astro:page-load', attachPhoneTiles);
</script>
