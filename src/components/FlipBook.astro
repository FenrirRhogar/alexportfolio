---
import { withBase } from '../lib/url';
import { sizeStyle } from '../lib/sizes';

interface Props {
  id: string;
  title: string;
  pages: string[];
  width: number;
  height: number;
  /** a display size from src/lib/sizes.ts */
  size?: string;
  class?: string;
}

const { id, title, pages, width, height, size, class: className = '' } = Astro.props;
const pageData = pages.map(withBase);
---

<div class:list={['flipbook-wrap mx-auto', className]} style={sizeStyle(size, '46rem')} data-flipbook-wrap>
  <div
    id={id}
    class="flipbook mx-auto"
    style={`aspect-ratio: ${width * 2} / ${height}`}
    data-flipbook
    data-pages={JSON.stringify(pageData)}
    data-width={width}
    data-height={height}
    aria-label={`${title} — page-flip viewer`}
  ></div>

  <div class="mt-5 flex items-center justify-center gap-6 text-sm uppercase tracking-widest text-ink-soft">
    <button type="button" data-flip-prev data-cursor-hover class="link-hover disabled:opacity-30" aria-label="Previous page">
      ← Prev
    </button>
    <span data-flip-counter class="text-xs tabular-nums">1 / {pages.length}</span>
    <button type="button" data-flip-next data-cursor-hover class="link-hover disabled:opacity-30" aria-label="Next page">
      Next →
    </button>
  </div>
</div>

<style>
  /* :global() — the PageFlip library takes ownership of this element's
     internals and it ends up without Astro's scope attribute, so a
     scoped selector here would never match it. */
  :global(.flipbook) {
    width: 100%;
    max-height: 80vh;
  }
  :global(.flipbook .stf__parent) {
    margin: 0 auto;
  }
  /* while the book is closed (front or back cover showing alone), slide it
     so that one page sits in the middle, like a real closed book */
  :global(.flipbook) {
    transition: transform 0.6s cubic-bezier(0.65, 0, 0.35, 1);
  }
  :global(.flipbook[data-closed='front']) {
    transform: translateX(-25%);
  }
  :global(.flipbook[data-closed='back']) {
    transform: translateX(25%);
  }
  :global(.flip-page) {
    background: var(--color-paper-dim);
  }
  :global(.flip-page img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    user-select: none;
    pointer-events: none;
  }
</style>

<script>
  import { PageFlip } from 'page-flip';

  function initFlipbooks() {
    document.querySelectorAll<HTMLElement>('[data-flipbook]').forEach((el) => {
      if (el.dataset.bound) return;
      el.dataset.bound = 'true';

      try {
        const pages: string[] = JSON.parse(el.dataset.pages || '[]');
        const wrap = el.closest('[data-flipbook-wrap]');
        if (!wrap || pages.length === 0) return;

        // Pages are real <img> elements (the library's HTML mode) rather than
        // canvas drawings: in canvas mode a lone cover gets a white blank
        // painted beside it, so the cover had to be switched off — which
        // put page 1 next to page 2 and every spread off by one. Here the
        // empty half stays transparent, so the first page is a proper cover
        // and the spreads are 2–3, 4–5… like a printed book.
        for (const [i, src] of pages.entries()) {
          const page = document.createElement('div');
          page.className = 'flip-page';
          // the covers are stiff, the inside pages bend
          if (i === 0 || i === pages.length - 1) page.dataset.density = 'hard';
          const img = document.createElement('img');
          img.src = src;
          img.alt = `${el.getAttribute('aria-label')?.split(' — ')[0] ?? ''} — page ${i + 1}`;
          img.loading = i < 4 ? 'eager' : 'lazy';
          page.appendChild(img);
          el.appendChild(page);
        }

        const pageFlip = new PageFlip(el, {
          width: Number(el.dataset.width),
          height: Number(el.dataset.height),
          size: 'stretch',
          minWidth: 90,
          maxWidth: 1400,
          minHeight: 200,
          maxHeight: 1400,
          maxShadowOpacity: 0.5,
          showCover: true,
          mobileScrollSupport: true,
        });

        pageFlip.loadFromHTML(el.querySelectorAll<HTMLElement>('.flip-page'));

        const counter = wrap.querySelector<HTMLElement>('[data-flip-counter]');
        const prevBtn = wrap.querySelector<HTMLButtonElement>('[data-flip-prev]');
        const nextBtn = wrap.querySelector<HTMLButtonElement>('[data-flip-next]');

        const updateCounter = () => {
          const i = pageFlip.getCurrentPageIndex();
          const twoUp = pageFlip.getOrientation() === 'landscape';
          // the front cover shows alone; so does the back one when the page
          // count is even (it has no facing page left)
          const closed = !twoUp ? '' : i === 0 ? 'front' : i === pages.length - 1 && pages.length % 2 === 0 ? 'back' : '';
          if (closed) el.dataset.closed = closed;
          else delete el.dataset.closed;
          if (counter) {
            const shown = twoUp && !closed && i + 1 < pages.length ? `${i + 1}–${i + 2}` : `${i + 1}`;
            counter.textContent = `${shown} / ${pages.length}`;
          }
        };
        pageFlip.on('changeOrientation', updateCounter);
        pageFlip.on('flip', updateCounter);
        updateCounter();

        prevBtn?.addEventListener('click', () => pageFlip.flipPrev());
        nextBtn?.addEventListener('click', () => pageFlip.flipNext());
      } catch (err) {
        console.error('FlipBook failed to initialize', el.id, err);
      }
    });
  }

  initFlipbooks();
  document.addEventListener('astro:page-load', initFlipbooks);
</script>
