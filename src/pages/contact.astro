---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact — Alex Rivera" description="Get in touch about design, motion, or fine art projects.">
  <section class="min-h-[92vh] flex flex-col items-center justify-center px-6 text-center">
    <p class="text-sm uppercase tracking-[0.3em] text-ink-soft mb-8 fade-up">
      Say hello
    </p>
    <a
      href="mailto:hello@yourname.com"
      data-cursor-hover
      class="fade-up font-display italic text-[12vw] md:text-[6.5vw] leading-none hover:text-terracotta transition-colors duration-500 break-all"
    >
      hello@yourname.com
    </a>
    <p class="fade-up mt-10 max-w-md text-ink-soft">
      For design, motion, or fine art inquiries — commissions, collaborations, and
      the occasional wild idea are all welcome.
    </p>

    <div class="fade-up flex items-center gap-8 mt-14 text-sm uppercase tracking-widest text-ink-soft">
      <a href="https://instagram.com/" data-cursor-hover class="link-hover" target="_blank" rel="noopener">Instagram</a>
      <a href="https://vimeo.com/" data-cursor-hover class="link-hover" target="_blank" rel="noopener">Vimeo</a>
      <a href="https://linkedin.com/" data-cursor-hover class="link-hover" target="_blank" rel="noopener">LinkedIn</a>
    </div>
  </section>
</Layout>
