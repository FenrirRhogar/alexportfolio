---
import Layout from '../layouts/Layout.astro';
import { withBase } from '../lib/url';
import { getEntry } from 'astro:content';

const site = (await getEntry('site', 'global')).data;
const bioParagraphs = site.aboutBio.split(/\n\s*\n/).filter(Boolean);
---

<Layout title={`About — ${site.brandName}`} description={site.heroSubheading}>
  <section class="px-6 md:px-10 pt-28 pb-24">
    <div class="grid md:grid-cols-2 gap-12 md:gap-20 items-start max-w-6xl">
      {site.aboutPhoto && (
        <div class="md:sticky md:top-32">
          <div class="aspect-4/5 overflow-hidden bg-paper-dim max-w-md">
            <img src={withBase(site.aboutPhoto)} alt={`${site.brandName} in the studio`} class="w-full h-full object-cover" />
          </div>
        </div>
      )}

      <div>
        <p class="text-sm uppercase tracking-[0.3em] text-ink-soft mb-6">{site.aboutEyebrow}</p>
        <h1 class="font-display italic text-3xl md:text-5xl leading-[0.95] mb-10">
          {site.aboutHeading}
        </h1>

        <div class="font-sans text-lg leading-relaxed text-ink-soft space-y-6 max-w-xl">
          {bioParagraphs.map((p) => <p>{p}</p>)}
          {site.aboutAvailability && (
            <p>
              {site.aboutAvailability}{' '}
              <a href={withBase('/contact/')} data-cursor-hover class="link-hover text-ink">Contact</a>.
            </p>
          )}
        </div>

        {site.skills.length > 0 && (
          <div class="mt-14">
            <p class="text-sm uppercase tracking-[0.3em] text-ink-soft mb-5">Tools</p>
            <ul class="flex flex-wrap gap-3">
              {site.skills.map((s) => (
                <li class="text-sm border border-ink/15 rounded-full px-4 py-2 text-ink-soft">{s}</li>
              ))}
            </ul>
          </div>
        )}
      </div>
    </div>
  </section>
</Layout>
