---
import Layout from '../../layouts/Layout.astro';
import PhoneTile from '../../components/PhoneTile.astro';
import { getCollection, getEntry } from 'astro:content';

const site = (await getEntry('site', 'global')).data;
const projects = (await getCollection('motion')).sort((a, b) => a.data.order - b.data.order);
---

<Layout title={`${site.motionEyebrow} — ${site.brandName}`} description={site.motionDescription}>
  <section class="px-6 md:px-10 pt-28 pb-12 max-w-4xl">
    <p class="fade-up text-sm uppercase tracking-[0.3em] font-semibold text-(--color-motion) mb-6">{site.motionEyebrow}</p>
    <h1 class="fade-up font-display italic text-4xl md:text-6xl leading-[0.95]" style="animation-delay: 80ms">
      {site.motionHeading}
    </h1>
  </section>

  <section class="px-6 md:px-10 pb-24">
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-6 md:gap-8 max-w-6xl mx-auto">
      {projects.map((p, i) => (
        <PhoneTile
          href={`/motion/${p.id}/`}
          poster={p.data.poster}
          video={p.data.video}
          videoWebm={p.data.videoWebm}
          title={p.data.title}
          meta={[p.data.role ?? 'Edit', p.data.year].filter(Boolean).join(' — ')}
          vertical={p.data.vertical}
          autoplay={site.autoplayVideos}
          revealDelay={(i % 4) * 80}
          class={p.data.vertical && i % 3 === 1 ? 'sm:mt-10' : p.data.vertical && i % 4 === 3 ? 'lg:mt-20' : ''}
        />
      ))}
    </div>
  </section>
</Layout>
