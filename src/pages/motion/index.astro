---
import Layout from '../../layouts/Layout.astro';
import PhoneTile from '../../components/PhoneTile.astro';
import { getCollection } from 'astro:content';

const projects = (await getCollection('motion')).sort((a, b) => a.data.order - b.data.order);
---

<Layout title="Motion & Video — Alexandra Patsi" description="Short-form edits, teasers, and social cuts.">
  <section class="px-6 md:px-10 pt-36 pb-16 max-w-4xl">
    <p class="text-sm uppercase tracking-[0.3em] text-ink-soft mb-6">Motion & Video</p>
    <h1 class="font-display italic text-5xl md:text-7xl leading-[0.95]">
      Cut for rhythm, not just coverage.
    </h1>
  </section>

  <section class="px-6 md:px-10 pb-32">
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-6 md:gap-8">
      {projects.map((p, i) => (
        <PhoneTile
          href={`/motion/${p.id}/`}
          poster={p.data.poster}
          video={p.data.video}
          videoWebm={p.data.videoWebm}
          title={p.data.title}
          meta={[p.data.role ?? 'Edit', p.data.year].filter(Boolean).join(' — ')}
          vertical={p.data.vertical}
          class={p.data.vertical && i % 3 === 1 ? 'sm:mt-10' : p.data.vertical && i % 4 === 3 ? 'lg:mt-20' : ''}
        />
      ))}
    </div>
  </section>
</Layout>
