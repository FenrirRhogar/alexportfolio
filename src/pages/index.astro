---
import Layout from '../layouts/Layout.astro';
import ProjectTile from '../components/ProjectTile.astro';
import { getCollection, getEntry } from 'astro:content';
import { withBase } from '../lib/url';

const site = (await getEntry('site', 'global')).data;

const design = (await getCollection('design')).filter((p) => p.data.featured);
const motion = (await getCollection('motion')).filter((p) => p.data.featured);
const fineart = (await getCollection('fineart')).filter((p) => p.data.featured);

const designTiles = design.map((p) => ({
    href: `/design/${p.id}/`,
    image: p.data.cover,
    title: p.data.title,
    meta: [p.data.category, p.data.year].filter(Boolean).join(' — '),
    discipline: 'Design',
    accent: 'var(--color-design)',
    order: p.data.order,
  }))
  .sort((a, b) => a.order - b.order);
const motionTiles = motion.map((p) => ({
    href: `/motion/${p.id}/`,
    image: p.data.poster,
    video: p.data.video,
    videoWebm: p.data.videoWebm,
    title: p.data.title,
    meta: [p.data.role ?? 'Edit', p.data.year].filter(Boolean).join(' — '),
    discipline: 'Motion',
    accent: 'var(--color-motion)',
    order: p.data.order,
  }))
  .sort((a, b) => a.order - b.order);
const fineartTiles = fineart.map((p) => ({
    href: `/fine-art/${p.id}/`,
    image: p.data.image,
    title: p.data.title,
    meta: [p.data.medium, p.data.year].filter(Boolean).join(' — '),
    discipline: 'Fine Art',
    accent: 'var(--color-fineart)',
    order: p.data.order,
  }))
  .sort((a, b) => a.order - b.order);

// Take one from each discipline in turn (each in its own dashboard order),
// so every discipline gets a place — order numbers are per collection, so
// sorting them all together would let one discipline crowd out the others.
// admin-server/server.mjs (homepageSelection) mirrors this to tell the
// dashboard which featured projects actually make it onto the homepage.
const featured = [];
for (let i = 0; featured.length < site.homeFeaturedCount; i++) {
  const round = [designTiles[i], motionTiles[i], fineartTiles[i]].filter(Boolean);
  if (!round.length) break;
  featured.push(...round);
}
featured.length = Math.min(featured.length, site.homeFeaturedCount);

// repeated so the strip is wider than any screen; the animation scrolls
// exactly half its width, which makes the loop seamless
const marqueeItems = site.marqueeText.split('·').map((t) => t.trim()).filter(Boolean);
const marqueeColors = ['var(--color-design)', 'var(--color-motion)', 'var(--color-fineart)'];
---

<Layout title={`${site.brandName} — Design, Motion & Fine Art`}>
  <section class="relative isolate px-6 md:px-10 pt-32 md:pt-36 pb-14">
    {site.animateHero && (
      <div class="hero-glow" aria-hidden="true"><span></span><span></span><span></span></div>
    )}
    <p class="fade-up accent-gradient-text text-sm uppercase tracking-[0.3em] font-semibold mb-6 w-fit">
      {site.heroEyebrow}
    </p>
    <h1 class="fade-up font-display italic text-[10vw] md:text-[6vw] leading-[0.95] tracking-tight max-w-6xl" style="animation-delay: 80ms">
      {site.heroHeading}
    </h1>
    <p class="fade-up mt-8 max-w-xl text-ink-soft text-lg" style="animation-delay: 160ms">
      {site.heroSubheading}
    </p>
  </section>

  {site.showMarquee && marqueeItems.length > 0 && (
    <div class="marquee mb-16 md:mb-20" aria-hidden="true">
      <div class="marquee-track py-5">
        {[0, 1].map(() => (
          <div class="flex shrink-0">
            {[...marqueeItems, ...marqueeItems].map((t, i) => (
              <span class="flex items-center gap-6 pr-6 font-display italic text-3xl md:text-4xl whitespace-nowrap">
                {t}
                <span class="inline-block h-2.5 w-2.5 rounded-full" style={`background: ${marqueeColors[i % 3]}`}></span>
              </span>
            ))}
          </div>
        ))}
      </div>
    </div>
  )}

  <section class="px-6 md:px-10 pb-24">
    <div class="flex items-baseline justify-between mb-10 max-w-6xl mx-auto">
      <h2 class="reveal font-display italic text-3xl md:text-4xl">{site.homeWorkHeading}</h2>
      <a href={withBase('/design/')} data-cursor-hover class="link-hover text-sm uppercase tracking-widest text-ink-soft hidden md:block">
        {site.homeWorkLink}
      </a>
    </div>

    <div class="columns-1 sm:columns-2 lg:columns-3 gap-8 max-w-6xl mx-auto">
      {featured.map((p, i) => (
        <ProjectTile
          href={p.href}
          image={p.image}
          video={site.autoplayVideos ? p.video : undefined}
          videoWebm={p.videoWebm}
          title={p.title}
          meta={p.meta}
          discipline={p.discipline}
          accent={p.accent}
          revealDelay={(i % 3) * 90}
          class={i % 3 === 1 ? 'sm:mt-16' : ''}
        />
      ))}
    </div>
  </section>
</Layout>
