---
import Layout from '../../layouts/Layout.astro';
import FlipBook from '../../components/FlipBook.astro';
import { getCollection, render } from 'astro:content';
import { withBase } from '../../lib/url';

export async function getStaticPaths() {
  const projects = await getCollection('design');
  return projects.map((p) => ({ params: { slug: p.id }, props: { entry: p } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, client, year, category, cover, gallery, booklets, tags } = entry.data;
const meta = [category, client, year].filter(Boolean).join(' — ');
---

<Layout title={`${title} — Alexandra Patsi`} description={entry.data.summary}>
  <article class="px-6 md:px-10 pt-28 pb-24">
    <header class="max-w-4xl mb-16">
      <p class="text-sm uppercase tracking-[0.3em] text-ink-soft mb-6">{meta}</p>
      <h1 class="font-display italic text-4xl md:text-6xl leading-[0.95]">{title}</h1>
      {tags.length > 0 && (
        <ul class="flex flex-wrap gap-3 mt-8">
          {tags.map((t: string) => (
            <li class="text-xs uppercase tracking-widest text-ink-soft border border-ink/15 rounded-full px-3 py-1">
              {t}
            </li>
          ))}
        </ul>
      )}
    </header>

    <div class="mb-16">
      <img src={withBase(cover)} alt={title} class="w-full h-auto" />
    </div>

    <div class="grid md:grid-cols-3 gap-16">
      <div class="md:col-span-2 prose-content font-sans text-lg leading-relaxed text-ink-soft max-w-2xl">
        <Content />
      </div>
    </div>

    {gallery.length > 0 && (
      <div class="mt-20 columns-1 sm:columns-2 gap-8">
        {gallery.map((img: string) => (
          <img src={withBase(img)} alt="" class="w-full h-auto mb-8 break-inside-avoid" />
        ))}
      </div>
    )}

    {booklets.length > 0 && (
      <div class="mt-20 space-y-20">
        {booklets.map((b) => (
          <div>
            <p class="text-center text-sm uppercase tracking-widest text-ink-soft mb-6">{b.title}</p>
            <FlipBook
              id={`flipbook-${b.title.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`}
              title={b.title}
              pages={b.pages}
              width={b.width}
              height={b.height}
            />
          </div>
        ))}
      </div>
    )}

    <div class="mt-24">
      <a href={withBase('/design/')} data-cursor-hover class="link-hover text-sm uppercase tracking-widest text-ink-soft">
        ← Back to Design & Branding
      </a>
    </div>
  </article>
</Layout>

<style>
  .prose-content :global(p) {
    margin-bottom: 1.5em;
  }
  .prose-content :global(strong) {
    color: var(--color-ink);
    font-weight: 600;
  }
</style>
