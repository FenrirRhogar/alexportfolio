---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { withBase } from '../../lib/url';

const works = (await getCollection('fineart')).sort((a, b) => a.data.order - b.data.order);
---

<Layout
  title="Fine Art — Alexandra Patsi"
  description="Paintings and studies."
  bodyClass="theme-dark"
>
  <section class="px-6 md:px-10 pt-36 pb-16 max-w-4xl">
    <p class="text-sm uppercase tracking-[0.3em] text-ink-soft mb-6">Fine Art</p>
    <h1 class="font-display italic text-5xl md:text-7xl leading-[0.95]">
      Paintings, mostly made before sunrise.
    </h1>
  </section>

  <section class="px-6 md:px-10 pb-32">
    <div class="columns-1 sm:columns-2 lg:columns-3 gap-10">
      {works.map((w, i) => (
        <a
          href={withBase(`/fine-art/${w.id}/`)}
          data-cursor-hover
          class:list={['group block break-inside-avoid mb-10', i % 2 === 1 ? 'sm:mt-16' : '']}
        >
          <div class="overflow-hidden bg-paper-dim">
            <img
              src={withBase(w.data.image)}
              alt={w.data.title}
              loading="lazy"
              class="w-full h-auto object-cover transition-transform duration-700 ease-out group-hover:scale-[1.03]"
            />
          </div>
          <div class="mt-4">
            <h3 class="font-display italic text-2xl">{w.data.title}</h3>
            <p class="text-sm text-ink-soft mt-1">
              {[w.data.medium, w.data.year].filter(Boolean).join(' — ')}
              {w.data.status && ` · ${w.data.status}`}
            </p>
          </div>
        </a>
      ))}
    </div>
  </section>
</Layout>
