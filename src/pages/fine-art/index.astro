---
import Layout from '../../layouts/Layout.astro';
import { getCollection, getEntry } from 'astro:content';
import { withBase } from '../../lib/url';

const site = (await getEntry('site', 'global')).data;
const works = (await getCollection('fineart')).sort((a, b) => a.data.order - b.data.order);
---

<Layout
  title={`${site.fineartEyebrow} — ${site.brandName}`}
  description={site.fineartDescription}
  bodyClass="theme-dark"
>
  <section class="px-6 md:px-10 pt-28 pb-12 max-w-4xl">
    <p class="fade-up text-sm uppercase tracking-[0.3em] font-semibold text-(--color-fineart) mb-6">{site.fineartEyebrow}</p>
    <h1 class="fade-up font-display italic text-4xl md:text-6xl leading-[0.95]" style="animation-delay: 80ms">
      {site.fineartHeading}
    </h1>
  </section>

  <section class="px-6 md:px-10 pb-24">
    <div class="columns-1 sm:columns-2 lg:columns-3 gap-10 max-w-6xl mx-auto">
      {works.map((w, i) => (
        <a
          href={withBase(`/fine-art/${w.id}/`)}
          data-cursor-hover
          class:list={['reveal group block break-inside-avoid mb-10', i % 2 === 1 ? 'sm:mt-16' : '']}
          style={`--tile-accent: var(--color-fineart); --reveal-delay: ${(i % 3) * 90}ms`}
        >
          <div class="overflow-hidden bg-paper-dim">
            <img
              src={withBase(w.data.image)}
              alt={w.data.title}
              loading="lazy"
              class="w-full h-auto object-cover transition-transform duration-700 ease-out group-hover:scale-[1.03]"
            />
          </div>
          <div class="tile-bar"></div>
          <div class="mt-4">
            <h3 class="font-display italic text-2xl transition-colors duration-300 group-hover:text-(--color-fineart)">{w.data.title}</h3>
            <p class="text-sm text-ink-soft mt-1">
              {[w.data.medium, w.data.year].filter(Boolean).join(' — ')}
              {w.data.status && ` · ${w.data.status}`}
            </p>
          </div>
        </a>
      ))}
    </div>
  </section>
</Layout>
