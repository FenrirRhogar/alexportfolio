---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const works = await getCollection('fineart');
  return works.map((w) => ({ params: { slug: w.id }, props: { entry: w } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, medium, dimensions, year, status, image } = entry.data;
---

<Layout title={`${title} — Alex Rivera`} description={entry.data.summary} bodyClass="theme-dark">
  <article class="px-6 md:px-10 pt-36 pb-32">
    <div class="mx-auto max-w-3xl">
      <img src={image} alt={title} class="w-full h-auto" />
      <header class="mt-10">
        <h1 class="font-display italic text-4xl md:text-5xl leading-[0.95]">{title}</h1>
        <p class="text-sm uppercase tracking-[0.2em] text-ink-soft mt-4">
          {medium}{dimensions && ` — ${dimensions}`} — {year}
          {status && ` · ${status}`}
        </p>
        <div class="font-sans text-lg leading-relaxed text-ink-soft mt-8 max-w-2xl prose-content">
          <Content />
        </div>
      </header>
    </div>

    <div class="mt-16 text-center">
      <a href="/fine-art/" data-cursor-hover class="link-hover text-sm uppercase tracking-widest text-ink-soft">
        ← Back to Fine Art
      </a>
    </div>
  </article>
</Layout>
