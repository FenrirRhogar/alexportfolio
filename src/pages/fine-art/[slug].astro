---
import Layout from '../../layouts/Layout.astro';
import FlipBook from '../../components/FlipBook.astro';
import TrifoldViewer from '../../components/TrifoldViewer.astro';
import { getCollection, getEntry, render } from 'astro:content';
import { withBase } from '../../lib/url';
import { sizeStyle, galleryColumns } from '../../lib/sizes';

export async function getStaticPaths() {
  const works = await getCollection('fineart');
  return works.map((w) => ({ params: { slug: w.id }, props: { entry: w } }));
}

const { entry } = Astro.props;
const site = (await getEntry('site', 'global')).data;
const { Content } = await render(entry);
const { title, medium, dimensions, year, status, image, gallery, booklets, trifolds, imageSize, gallerySize } = entry.data;

const meta = [medium, dimensions, year].filter(Boolean).join(' — ') + (status ? ` · ${status}` : '');
---

<Layout title={`${title} — Alexandra Patsi`} description={entry.data.summary} bodyClass="theme-dark">
  <article class="px-6 md:px-10 pt-28 pb-24">
    <div class="mx-auto" style={sizeStyle(imageSize, '48rem')}>
      <img src={withBase(image)} alt={title} class="w-full h-auto" />
    </div>
    <div class="mx-auto max-w-3xl">
      <header class="mt-10">
        <h1 class="font-display italic text-3xl md:text-4xl leading-[0.95]">{title}</h1>
        {meta && <p class="text-sm uppercase tracking-[0.2em] text-ink-soft mt-4">{meta}</p>}
        <div class="font-sans text-lg leading-relaxed text-ink-soft mt-8 max-w-2xl prose-content">
          <Content />
        </div>
      </header>

    </div>

    {gallery.length > 0 && (
      <div class:list={['mt-16 gap-8 mx-auto', galleryColumns(entry.data.galleryColumns)]} style={sizeStyle(gallerySize, '48rem')}>
        {gallery.map((img: string) => (
          <img src={withBase(img)} alt="" class="w-full h-auto mb-8 break-inside-avoid" />
        ))}
      </div>
    )}

    {booklets.length > 0 && (
      <div class="mt-20 space-y-20">
        {booklets.map((b) => (
          <div>
            <p class="text-center text-sm uppercase tracking-widest text-ink-soft mb-6">{b.title}</p>
            <FlipBook
              id={`flipbook-${b.title.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`}
              title={b.title}
              pages={b.pages}
              width={b.width}
              height={b.height}
              size={b.size}
            />
          </div>
        ))}
      </div>
    )}

    {trifolds.length > 0 && (
      <div class="mt-20 space-y-20">
        {trifolds.map((t) => (
          <div>
            <p class="text-center text-sm uppercase tracking-widest text-ink-soft mb-6">{t.title}</p>
            <TrifoldViewer title={t.title} outside={t.outside} inside={t.inside} size={t.size} />
          </div>
        ))}
      </div>
    )}

    <div class="mt-16 text-center">
      <a href={withBase('/fine-art/')} data-cursor-hover class="link-hover text-sm uppercase tracking-widest text-ink-soft">
        ← Back to {site.navFineArt}
      </a>
    </div>
  </article>
</Layout>
