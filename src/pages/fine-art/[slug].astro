---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import { withBase } from '../../lib/url';

export async function getStaticPaths() {
  const works = await getCollection('fineart');
  return works.map((w) => ({ params: { slug: w.id }, props: { entry: w } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, medium, dimensions, year, status, image, gallery } = entry.data;

const meta = [medium, dimensions, year].filter(Boolean).join(' — ') + (status ? ` · ${status}` : '');
---

<Layout title={`${title} — Alexandra Patsi`} description={entry.data.summary} bodyClass="theme-dark">
  <article class="px-6 md:px-10 pt-28 pb-24">
    <div class="mx-auto max-w-3xl">
      <img src={withBase(image)} alt={title} class="w-full h-auto" />
      <header class="mt-10">
        <h1 class="font-display italic text-3xl md:text-4xl leading-[0.95]">{title}</h1>
        {meta && <p class="text-sm uppercase tracking-[0.2em] text-ink-soft mt-4">{meta}</p>}
        <div class="font-sans text-lg leading-relaxed text-ink-soft mt-8 max-w-2xl prose-content">
          <Content />
        </div>
      </header>

      {gallery.length > 0 && (
        <div class="mt-16 columns-1 sm:columns-2 gap-8">
          {gallery.map((img: string) => (
            <img src={withBase(img)} alt="" class="w-full h-auto mb-8 break-inside-avoid" />
          ))}
        </div>
      )}
    </div>

    <div class="mt-16 text-center">
      <a href={withBase('/fine-art/')} data-cursor-hover class="link-hover text-sm uppercase tracking-widest text-ink-soft">
        ← Back to Fine Art
      </a>
    </div>
  </article>
</Layout>
